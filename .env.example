# Copy to .env. Never commit secrets.
# Anvil's well-known account 0 is fine for a local dry-run. Do not use it anywhere else.

PRIVATE_KEY=
ADMIN=
KICKBACK_PUBLISHER=
# Buyback keeper and Kickback keeper, granted at deploy. Leave empty to grant neither.
# This is an address, not a key. Do not put a private key here.
KEEPER=

# Elysium testnet. The deploy script refuses every other chain id except 31337.
RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
CHAIN_ID=99801

# Optional. Leave unset for Elysium. Set both to point `npm run dev` at a local Anvil (chain id 31337).
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# NEXT_PUBLIC_CHAIN_ID=31337

# Canonical fee wallet. A plain EOA, nonce 0 on 99801 and 99901 as of 9 Nov 2026.
FEE_WALLET=0xf4383D1Ecfb525294A266929c7D4796314a764F9

# Host Postgres. No Postgres container.
DATABASE_URL=postgres://launchpad@/launchpad?host=/var/run/postgresql

# Optional. RainbowKit adds WalletConnect when this is set. Leave it empty to offer injected wallets only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Live 99801 deployment. Override only for a local Anvil. See deployments/99801.json.
NEXT_PUBLIC_ROUTER=0x2051f1087D1E5B427071dce49f64c413902C900E
NEXT_PUBLIC_QUOTER=0x73FAC4Fa0b0300eA98F464DFC175CA882Ec00ea6
NEXT_PUBLIC_STATE_VIEW=0x0F99A9df2A94695934fdF753f2309A633651FcaE
NEXT_PUBLIC_LAUNCHER=0xCe7F2E8d1B5e8B62f5a9FE81107f60992d97FdfB
NEXT_PUBLIC_HOOK=0x11250C2cD56d4E37a3f8390570A99703848768cC

# Conduit Blockscout. {hash} is replaced.
NEXT_PUBLIC_EXPLORER_TX_URL_TEMPLATE=https://explorer-elysium-testnet.t.conduit.xyz/tx/{hash}
INDEXER_START_BLOCK=26803633
INDEXER_POLL_MS=12000
INDEXER_CONFIRMATIONS=12
LAUNCHER_ADDRESS=0xCe7F2E8d1B5e8B62f5a9FE81107f60992d97FdfB
HOOK_ADDRESS=0x11250C2cD56d4E37a3f8390570A99703848768cC
POOL_MANAGER_ADDRESS=0x41776AAa3441ED4C80F02BF97E48160fB0277746
BUYBACK_EXECUTOR=0x3999C34854d12E0E12bc3179559202Cb48D7c78D
KICKBACK_DISTRIBUTOR=0xDc5312c71313C01569865FFC30Bd3ba15a4B22Db
KEEPER_ADDRESS=0x6071b00861a449dfA741055F1E54343DDf7C1a42
API_PORT=3001

# Path to the keeper key. Never put the key itself in this file or in the image.
# The file is mode 600 and owned by root, or a Docker secret such as /run/secrets/keeper_key.
KEEPER_PRIVATE_KEY=
KEEPER_MAX_FEE_GWEI=100
KEEPER_MAX_GAS=12000000
# KICKBACK_MANIFEST_DIR=/var/lib/seedix/manifests

# Optional. When set, the board, chart, Kickback history, and portfolio read this API.
# Leave it empty to read listings from the chain. Example: http://127.0.0.1:3001
NEXT_PUBLIC_API_URL=
