# Copy to .env. Never commit secrets.
# Anvil's well-known account 0 is fine for a local dry-run. Do not use it anywhere else.

PRIVATE_KEY=
ADMIN=
KICKBACK_PUBLISHER=
# Buyback keeper and Kickback keeper, granted at deploy. Leave empty to grant neither.
# This is an address, not a key. Do not put a private key here.
KEEPER=

# Elysium testnet. The deploy script refuses every other chain id except 31337.
# Public RPC. The API, indexer, and keeper read RPC_URL. No key belongs here.
RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
CHAIN_ID=99801

# Web RPC. Next inlines NEXT_PUBLIC_RPC_URL at build time, so Compose passes it as a build arg.
# The default is the public Elysium endpoint. NEXT_PUBLIC_RPC_URLS is an optional comma-separated fallback list.
# Point both at Anvil only for a local fork, and set NEXT_PUBLIC_CHAIN_ID=31337 with them.
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
# NEXT_PUBLIC_RPC_URLS=
# NEXT_PUBLIC_CHAIN_ID=31337

# Canonical fee wallet. A plain EOA, nonce 0 on 99801 and 99901 as of 9 Nov 2026.
FEE_WALLET=0xf4383D1Ecfb525294A266929c7D4796314a764F9

# Host Postgres. No Postgres container.
DATABASE_URL=postgres://launchpad@/launchpad?host=/var/run/postgresql

# Placeholder only. Do not commit a real project id.
# The server file /etc/seedix/app.env holds the real id. Compose passes it as a web build arg.
# See docs/deploy-runbook.md. An empty or placeholder value hides WalletConnect.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=replace-with-walletconnect-project-id

# Live 99801 deployment. Override only for a local Anvil. See deployments/99801.json.
NEXT_PUBLIC_ROUTER=0xaC65DD1fAAbA63A18ADC609F6b53dfAB879Bb8C3
NEXT_PUBLIC_QUOTER=0xD74E39d881E47d153FBB767CAa68140DbF35b3Bd
NEXT_PUBLIC_STATE_VIEW=0x667cb2cDB37C6c9328D1096Ed51b1Fd6136cb1aA
NEXT_PUBLIC_LAUNCHER=0xeDE448d4325763C7CcBaae75FcdCC6cC6b75fc3e
NEXT_PUBLIC_HOOK=0x6cf82a15C0405475552f1839DA26D964ec19a8Cc

# Conduit Blockscout. {hash} is replaced.
NEXT_PUBLIC_EXPLORER_TX_URL_TEMPLATE=https://explorer-elysium-testnet.t.conduit.xyz/tx/{hash}
INDEXER_START_BLOCK=27047311
INDEXER_POLL_MS=12000
INDEXER_CONFIRMATIONS=12
LAUNCHER_ADDRESS=0xeDE448d4325763C7CcBaae75FcdCC6cC6b75fc3e
HOOK_ADDRESS=0x6cf82a15C0405475552f1839DA26D964ec19a8Cc
POOL_MANAGER_ADDRESS=0x82C6E26D3eb5d9955b538dABE3C71b2c3c878c09
BUYBACK_EXECUTOR=0xfdb16Fa1Dd6c2fF7980e8323De5085F497F67366
KICKBACK_DISTRIBUTOR=0xd00eb7114f8aF86b52393893E92559308df50372
METADATA_ADDRESS=0x78238762b95cA6CF57C8e1ef0010ccEdD030a919
KEEPER_ADDRESS=0x6071b00861a449dfA741055F1E54343DDf7C1a42
API_PORT=3001

# Path to the keeper key. Never put the key itself in this file or in the image.
# The file is mode 600 and owned by root, or a Docker secret such as /run/secrets/keeper_key.
KEEPER_PRIVATE_KEY=
KEEPER_MAX_FEE_GWEI=100
KEEPER_MAX_GAS=12000000
# KICKBACK_MANIFEST_DIR=/var/lib/seedix/manifests

# Optional. When set, the board, chart, Kickback history, and portfolio read this API.
# Leave it empty to read listings from the chain. Example: http://127.0.0.1:3001
NEXT_PUBLIC_API_URL=
