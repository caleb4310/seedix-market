# Copy to .env. Never commit secrets.
# Anvil's well-known account 0 is fine for a local dry-run. Do not use it anywhere else.

PRIVATE_KEY=
ADMIN=
KICKBACK_PUBLISHER=
# Address that may call buyback and Kickback push. Not a private key.
KEEPER=

# Elysium testnet. The deploy script refuses every other chain id except 31337.
RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
CHAIN_ID=99801

# Optional. Leave unset for Elysium. Set both to point `npm run dev` at a local Anvil (chain id 31337).
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# NEXT_PUBLIC_CHAIN_ID=31337

# Canonical fee wallet. A plain EOA, nonce 0 on 99801 and 99901 as of 9 Nov 2026.
FEE_WALLET=0xf4383D1Ecfb525294A266929c7D4796314a764F9

# Host Postgres. No Postgres container.
DATABASE_URL=postgres://launchpad@/launchpad?host=/var/run/postgresql

# Optional. RainbowKit adds WalletConnect when this is set. Leave it empty to offer injected wallets only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional. The trade card quotes and signs only when the router, quoter, and state view are set.
NEXT_PUBLIC_ROUTER=
NEXT_PUBLIC_QUOTER=
NEXT_PUBLIC_STATE_VIEW=

# Optional. Production reads CoinLaunched logs from the launcher and hook.config from the hook.
NEXT_PUBLIC_LAUNCHER=
NEXT_PUBLIC_HOOK=

# Transaction links. {hash} is replaced. Confirm this path on the first testnet transaction.
NEXT_PUBLIC_EXPLORER_TX_URL_TEMPLATE=https://testnet.elysium.kinetiq.xyz/tx/{hash}
