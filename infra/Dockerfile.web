FROM node:22-bookworm

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY services/shared/package.json services/shared/package.json
COPY services/api/package.json services/api/package.json
COPY services/indexer/package.json services/indexer/package.json
COPY services/keeper/package.json services/keeper/package.json
COPY services/kickback/package.json services/kickback/package.json

RUN npm ci

COPY . .

# Next.js inlines NEXT_PUBLIC_* into the browser bundle at build time.
# The real WalletConnect project id is passed by Compose from /etc/seedix/app.env.
# It is not stored in this file or in the git repo. An empty value hides WalletConnect.
ARG NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
ARG NEXT_PUBLIC_API_URL=/api
ARG NEXT_PUBLIC_CHAIN_ID=84532
ARG NEXT_PUBLIC_CHAIN_NAME=Base Sepolia
ARG NEXT_PUBLIC_NATIVE_SYMBOL=ETH
ARG NEXT_PUBLIC_RPC_URL=https://base-sepolia-rpc.publicnode.com
ARG NEXT_PUBLIC_RPC_URLS=
ARG NEXT_PUBLIC_EXPLORER_TX_URL_TEMPLATE=https://sepolia.basescan.org/tx/{hash}
ARG NEXT_PUBLIC_ZRO_TAX_ENABLED=true
ARG NEXT_PUBLIC_ZRO_REMOTE_CLAIM_ENABLED=false
ARG NEXT_PUBLIC_PRICE_ID=ethereum
ARG NEXT_PUBLIC_LAUNCHER=0xb0F9D152e76D5232A13672EA531aD7BB223e81FB
ARG NEXT_PUBLIC_HOOK=0xF76b84C90c49a785322f110c66d1155bc26228cC
ARG NEXT_PUBLIC_ROUTER=0xade24CcEb8309b22b9c74D90da93B7A3F1e06239
ARG NEXT_PUBLIC_QUOTER=0x5e6B8B8AFA7e5CEF6C09dd2A67aBA9FB12C75623
ARG NEXT_PUBLIC_STATE_VIEW=0x571291b572ed32ce6751a2cb2486ebee8defb9b4
ARG NEXT_PUBLIC_KICKBACK=0xd6CfAfb4f77F7f62602ea861027eA55667fd4840
ARG NEXT_PUBLIC_WETH=0x4200000000000000000000000000000000000006
ARG NEXT_PUBLIC_COIN_METADATA=0xE54B8640a61dC7Ef741b0Ca0A06be885A4Ee6118
ARG NEXT_PUBLIC_EXECUTOR=0x1885501719d334A7f193aed6F1038b15b42075d3
ARG NEXT_PUBLIC_INDEXER_START_BLOCK=60147699
ENV NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=$NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_CHAIN_ID=$NEXT_PUBLIC_CHAIN_ID
ENV NEXT_PUBLIC_CHAIN_NAME=$NEXT_PUBLIC_CHAIN_NAME
ENV NEXT_PUBLIC_NATIVE_SYMBOL=$NEXT_PUBLIC_NATIVE_SYMBOL
ENV NEXT_PUBLIC_RPC_URL=$NEXT_PUBLIC_RPC_URL
ENV NEXT_PUBLIC_RPC_URLS=$NEXT_PUBLIC_RPC_URLS
ENV NEXT_PUBLIC_EXPLORER_TX_URL_TEMPLATE=$NEXT_PUBLIC_EXPLORER_TX_URL_TEMPLATE
ENV NEXT_PUBLIC_ZRO_TAX_ENABLED=$NEXT_PUBLIC_ZRO_TAX_ENABLED
ENV NEXT_PUBLIC_ZRO_REMOTE_CLAIM_ENABLED=$NEXT_PUBLIC_ZRO_REMOTE_CLAIM_ENABLED
ENV NEXT_PUBLIC_PRICE_ID=$NEXT_PUBLIC_PRICE_ID
ENV NEXT_PUBLIC_LAUNCHER=$NEXT_PUBLIC_LAUNCHER
ENV NEXT_PUBLIC_HOOK=$NEXT_PUBLIC_HOOK
ENV NEXT_PUBLIC_ROUTER=$NEXT_PUBLIC_ROUTER
ENV NEXT_PUBLIC_QUOTER=$NEXT_PUBLIC_QUOTER
ENV NEXT_PUBLIC_STATE_VIEW=$NEXT_PUBLIC_STATE_VIEW
ENV NEXT_PUBLIC_KICKBACK=$NEXT_PUBLIC_KICKBACK
ENV NEXT_PUBLIC_WETH=$NEXT_PUBLIC_WETH
ENV NEXT_PUBLIC_COIN_METADATA=$NEXT_PUBLIC_COIN_METADATA
ENV NEXT_PUBLIC_EXECUTOR=$NEXT_PUBLIC_EXECUTOR
ENV NEXT_PUBLIC_INDEXER_START_BLOCK=$NEXT_PUBLIC_INDEXER_START_BLOCK
ENV NEXT_TELEMETRY_DISABLED=1

RUN npm run build -w @seedix/web

EXPOSE 3000

CMD ["npm", "run", "start", "-w", "@seedix/web", "--", "--hostname", "0.0.0.0", "--port", "3000"]
