# Base Sepolia app env. Copy to /etc/seedix/app.env on the server.
# Public values are filled. Secrets are placeholders. Never put a private key in this file.

# Chain
CHAIN_ID=84532
CHAIN_NAME=Base Sepolia
NATIVE_CURRENCY_SYMBOL=ETH
RPC_URL=https://base-sepolia-rpc.publicnode.com
PRICE_COINGECKO_ID=ethereum
EXPLORER_TX_URL_TEMPLATE=https://sepolia.basescan.org/tx/{hash}
EXPLORER_ADDRESS_URL_TEMPLATE=https://sepolia.basescan.org/address/{address}

# Web build. Next inlines NEXT_PUBLIC_* . Changing one requires a rebuild.
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_CHAIN_NAME=Base Sepolia
NEXT_PUBLIC_NATIVE_SYMBOL=ETH
NEXT_PUBLIC_RPC_URL=https://base-sepolia-rpc.publicnode.com
NEXT_PUBLIC_RPC_URLS=
NEXT_PUBLIC_EXPLORER_TX_URL_TEMPLATE=https://sepolia.basescan.org/tx/{hash}
NEXT_PUBLIC_EXPLORER_ADDRESS_URL_TEMPLATE=https://sepolia.basescan.org/address/{address}
NEXT_PUBLIC_PRICE_ID=ethereum
NEXT_PUBLIC_ZRO_TAX_ENABLED=true
NEXT_PUBLIC_ZRO_REMOTE_CLAIM_ENABLED=false
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=replace-with-walletconnect-project-id
NEXT_PUBLIC_LAUNCHER=0xb0F9D152e76D5232A13672EA531aD7BB223e81FB
NEXT_PUBLIC_HOOK=0xF76b84C90c49a785322f110c66d1155bc26228cC
NEXT_PUBLIC_ROUTER=0xade24CcEb8309b22b9c74D90da93B7A3F1e06239
NEXT_PUBLIC_QUOTER=0x5e6B8B8AFA7e5CEF6C09dd2A67aBA9FB12C75623
NEXT_PUBLIC_STATE_VIEW=0x571291b572ed32ce6751a2cb2486ebee8defb9b4
NEXT_PUBLIC_KICKBACK=0xd6CfAfb4f77F7f62602ea861027eA55667fd4840
NEXT_PUBLIC_WETH=0x4200000000000000000000000000000000000006
NEXT_PUBLIC_COIN_METADATA=0xE54B8640a61dC7Ef741b0Ca0A06be885A4Ee6118
NEXT_PUBLIC_EXECUTOR=0x1885501719d334A7f193aed6F1038b15b42075d3
NEXT_PUBLIC_INDEXER_START_BLOCK=60147699
# NEXT_PUBLIC_PRIORITY_FEE_WEI=1000000

# Indexer and services. Addresses are the deployed Base Sepolia contracts.
DEPLOYMENT_FILE=deployments/base-sepolia.json
INDEXER_START_BLOCK=60147699
INDEXER_POLL_MS=12000
INDEXER_CONFIRMATIONS=12
LAUNCHER_ADDRESS=0xb0F9D152e76D5232A13672EA531aD7BB223e81FB
HOOK_ADDRESS=0xF76b84C90c49a785322f110c66d1155bc26228cC
POOL_MANAGER_ADDRESS=0x05E73354cFDd6745C338b50BcFDfA3Aa6fA03408
BUYBACK_EXECUTOR=0x1885501719d334A7f193aed6F1038b15b42075d3
KICKBACK_DISTRIBUTOR=0xd6CfAfb4f77F7f62602ea861027eA55667fd4840
METADATA_ADDRESS=0xE54B8640a61dC7Ef741b0Ca0A06be885A4Ee6118
PAIR_ADDRESSES=0x4200000000000000000000000000000000000006
KEEPER_ADDRESS=0x86d9AB7C8A915DBf9dd2C2ba533d10bdb87801D6
FEE_WALLET=0x86d9AB7C8A915DBf9dd2C2ba533d10bdb87801D6
API_PORT=3001
API_URL=http://api:3001
API_HOST=0.0.0.0

# Host Postgres. Use a new database for Base Sepolia. Do not reuse the Elysium database.
DATABASE_URL=postgres://launchpad:replace-with-db-password@/seedix_base?host=/var/run/postgresql

# Secrets. These are file paths, never the key itself.
# install -m 600 -o root /dev/null /etc/seedix/keeper.key
SEEDIX_KEEPER_KEY_FILE=/etc/seedix/keeper.key
KEEPER_PRIVATE_KEY=/etc/seedix/keeper.key
SEEDIX_PUBLISHER_KEY_FILE=/etc/seedix/publisher.key
PUBLISHER_PRIVATE_KEY=/etc/seedix/publisher.key
KEEPER_MAX_FEE_GWEI=100
KEEPER_MAX_GAS=12000000
# KEEPER_PRIORITY_FEE_WEI=1000000
# KICKBACK_PRIORITY_FEE_WEI=1000000
KICKBACK_MANIFEST_DIR=/var/lib/seedix/manifests
KICKBACK_DRY_RUN=

# Elysium remains selectable. Set CHAIN_ID=99801, NATIVE_CURRENCY_SYMBOL=HYPE,
# PRICE_COINGECKO_ID=hyperliquid, NEXT_PUBLIC_ZRO_TAX_ENABLED=false, and the 99801 addresses.
